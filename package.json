{
  "name": "ecourts-india-platform",
  "version": "1.0.0",
  "description": "Indian Court Data Ingestion & Intelligence Platform - Foundation & Application Shell",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run start --prefix backend",
    "build": "npm run build --prefix frontend",
    "test:backend": "npm run test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "legaltech",
    "ecourts",
    "india",
    "court-data",
    "intelligence"
  ],
  "author": "",
  "license": "ISC"
}
